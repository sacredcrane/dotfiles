font=JetBrainsMono Nerd Font Mono 11
background-color=#1e1e2ef5
text-color=#cdd6f4ff
border-color=#cba6f7ff
progress-color=over #313244ff

width=360
height=140
outer-margin=12
margin=8
padding=12
border-size=1
border-radius=14

icons=1
max-icon-size=44
icon-border-radius=8
markup=1
actions=1
format=<b>%s</b>\n%b

layer=overlay
anchor=top-right
sort=-time
max-visible=5
history=1
max-history=20
group-by=app-name
default-timeout=6000
ignore-timeout=0

on-button-left=invoke-default-action
on-button-middle=dismiss
on-button-right=dismiss

[urgency=low]
border-color=#74c7ecff
default-timeout=4000

[urgency=normal]
border-color=#cba6f7ff

[urgency=critical]
background-color=#181825fa
border-color=#f38ba8ff
default-timeout=0
ignore-timeout=1

[app-name=brightness-osd]
border-color=#f9e2afff
default-timeout=1200
ignore-timeout=1

[app-name=volume-osd]
border-color=#89b4faff
default-timeout=1200
ignore-timeout=1
