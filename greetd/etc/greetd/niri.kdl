environment {
    XCURSOR_THEME "Adwaita"
    XCURSOR_SIZE "24"
}

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

hotkey-overlay {
    skip-at-startup
}

spawn-sh-at-startup "regreet; niri msg action quit --skip-confirmation"
