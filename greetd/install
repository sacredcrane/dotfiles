#!/bin/sh

set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
login_user=${LOGIN_USER:-${DOAS_USER:-${SUDO_USER:-}}}

for program in cage regreet; do
    if ! command -v "$program" >/dev/null 2>&1; then
        printf '%s\n' "greetd: $program is required" >&2
        exit 1
    fi
done

if [ -z "$login_user" ]; then
    printf '%s\n' 'greetd: set LOGIN_USER when running directly as root' >&2
    exit 1
fi

login_home=$(getent passwd "$login_user" | cut -d: -f6)
icon_source="$login_home/.icons"
for theme in Papirus Papirus-Dark catppuccin-mocha-mauve-cursors; do
    if [ ! -d "$icon_source/$theme" ]; then
        printf '%s\n' "greetd: run install-icon-cursor-themes as $login_user first" >&2
        exit 1
    fi
done

if [ -f /etc/greetd/config.toml ] && [ ! -f /etc/greetd/config.toml.tuigreet ]; then
    install -m644 /etc/greetd/config.toml /etc/greetd/config.toml.tuigreet
fi

install -Dm644 "$repo/greetd/etc/greetd/regreet.toml" /etc/greetd/regreet.toml
install -Dm644 "$repo/greetd/etc/greetd/regreet.css" /etc/greetd/regreet.css
install -Dm644 \
    "$repo/wallpaper/.local/share/wallpapers/village.png" \
    /etc/greetd/background.png

if [ -f /usr/share/wayland-sessions/niri.desktop ] && \
    [ ! -f /usr/share/wayland-sessions/niri.desktop.package ]; then
    install -m644 \
        /usr/share/wayland-sessions/niri.desktop \
        /usr/share/wayland-sessions/niri.desktop.package
fi
install -Dm644 \
    "$repo/greetd/usr/share/wayland-sessions/niri.desktop" \
    /usr/share/wayland-sessions/niri.desktop
install -Dm755 \
    "$repo/greetd/usr/local/bin/niri-void-session" \
    /usr/local/bin/niri-void-session

install -d -m755 -o _greeter -g _greeter /var/lib/regreet /var/log/regreet

font_source="$login_home/.local/share/fonts/JetBrainsMonoNerd"

if [ -d "$font_source" ]; then
    install -d /usr/local/share/fonts/JetBrainsMonoNerd
    cp -R "$font_source/." /usr/local/share/fonts/JetBrainsMonoNerd/
    fc-cache -f /usr/local/share/fonts/JetBrainsMonoNerd
fi

install -d /usr/local/share/icons
for theme in Papirus Papirus-Dark catppuccin-mocha-mauve-cursors; do
    rm -rf "/usr/local/share/icons/$theme"
    cp -R "$icon_source/$theme" /usr/local/share/icons/
done

# Switch greetd only after every dependency and supporting file is in place.
install -Dm644 "$repo/greetd/etc/greetd/config.toml" /etc/greetd/config.toml
