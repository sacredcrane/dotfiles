#!/bin/sh

set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
login_user=${DOAS_USER:-${SUDO_USER:-}}

niri validate -c "$repo/greetd/etc/greetd/niri.kdl"

if [ -f /etc/greetd/config.toml ] && [ ! -f /etc/greetd/config.toml.tuigreet ]; then
    install -m644 /etc/greetd/config.toml /etc/greetd/config.toml.tuigreet
fi

install -Dm644 "$repo/greetd/etc/greetd/config.toml" /etc/greetd/config.toml
install -Dm644 "$repo/greetd/etc/greetd/niri.kdl" /etc/greetd/niri.kdl
install -Dm644 "$repo/greetd/etc/greetd/regreet.toml" /etc/greetd/regreet.toml
install -Dm644 "$repo/greetd/etc/greetd/regreet.css" /etc/greetd/regreet.css
install -Dm644 \
    "$repo/wallpaper/.local/share/wallpapers/village.png" \
    /etc/greetd/background.png

install -d -m755 -o _greeter -g _greeter /var/lib/regreet /var/log/regreet

if [ -n "$login_user" ]; then
    login_home=$(getent passwd "$login_user" | cut -d: -f6)
    font_source="$login_home/.local/share/fonts/JetBrainsMonoNerd"

    if [ -d "$font_source" ]; then
        install -d /usr/local/share/fonts/JetBrainsMonoNerd
        cp -R "$font_source/." /usr/local/share/fonts/JetBrainsMonoNerd/
        fc-cache -f /usr/local/share/fonts/JetBrainsMonoNerd
    fi
fi
