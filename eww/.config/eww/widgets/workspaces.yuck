(deflisten workspaces-data
  :initial "[]"
  "$HOME/.config/eww/scripts/workspaces.sh")

(defwidget workspaces[]
  (box
    :class "workspaces"
    :orientation "v"
    :space-evenly false
    :spacing 6
    
    (for ws in workspaces-data
      (button
        :class {ws.active ? "workspace active" : "workspace"}
        :onclick `niri msg action focus-workspace ${ws.idx}`
        "${ws.idx}"))))
