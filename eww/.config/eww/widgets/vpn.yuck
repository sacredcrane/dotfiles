(defpoll vpn-data
  :interval "3s"
  :initial "{\"profile\":\"my_pc\",\"active\":false,\"address\":\"\"}"
  "$HOME/.config/eww/scripts/vpn-status.sh")

(defwidget vpn []
  (button
    :class {vpn-data.active ? "metric vpn active" : "metric vpn"}
    :tooltip {vpn-data.active ? "VPN · my_pc" : "VPN disconnected"}
    :onclick "$HOME/.config/eww/scripts/popup-toggle.sh vpn-popup"

    (label
      :class "metric-icon"
      :text {vpn-data.active ? "󰦝" : "󰦜"})))

(defwidget vpn-popup-content []
  (eventbox
    :onhoverlost "eww close vpn-popup"

    (box
      :class "vpn-popup"
      :orientation "v"
      :space-evenly false
      :spacing 8

      (box
        :orientation "h"
        :space-evenly false

        (label
          :class "network-title"
          :hexpand true
          :halign "start"
          :text "VPN")

        (label
          :class "network-info"
          :text "AmneziaWG"))

      (box
        :class "network-separator")

      (button
        :class {vpn-data.active ? "vpn-profile active" : "vpn-profile"}
        :tooltip {vpn-data.active ? "Disconnect my_pc" : "Connect my_pc"}
        :onclick {
          vpn-data.active
            ? "$HOME/.config/eww/scripts/vpn-action.sh disconnect"
            : "$HOME/.config/eww/scripts/vpn-action.sh connect"
        }

        (box
          :orientation "h"
          :space-evenly false
          :spacing 8

          (label
            :class "vpn-profile-icon"
            :text {vpn-data.active ? "󰦝" : "󰦜"})

          (box
            :orientation "v"
            :hexpand true
            :halign "start"
            :space-evenly false

            (label
              :class "vpn-profile-name"
              :halign "start"
              :text "my_pc")

            (label
              :class "vpn-address"
              :halign "start"
              :text {vpn-data.active ? vpn-data.address : "No tunnel"}))

          (label
            :class {vpn-data.active ? "vpn-profile-state active" : "vpn-profile-state"}
            :text {vpn-data.active ? "Connected" : "Connect"}))))))

(defwindow vpn-popup
  :monitor 0
  :geometry (geometry
    :x "8px"
    :y "130px"
    :width "220px"
    :height "105px"
    :anchor "right bottom")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-vpn-popup"

  (vpn-popup-content))
