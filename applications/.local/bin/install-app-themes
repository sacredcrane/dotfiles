#!/bin/sh

set -eu

chrome_version=v5.0.0
chrome_theme=catppuccin-chrome-mocha-mauve
chrome_sha256=d841de83790103219003a1ef66a0805b18b44d1af23d893d127f976ef90fd246
data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
chrome_target="$data_home/chromium-themes/$chrome_theme"
tmp=$(mktemp -d)

trap 'rm -rf "$tmp"' EXIT HUP INT TERM

curl --fail --location --silent --show-error \
    "https://github.com/catppuccin/chrome/releases/download/$chrome_version/$chrome_theme.zip" \
    --output "$tmp/$chrome_theme.zip"
printf '%s  %s\n' "$chrome_sha256" "$tmp/$chrome_theme.zip" \
    | sha256sum --check --status

install -d "$chrome_target"
unzip -oq "$tmp/$chrome_theme.zip" -d "$chrome_target"

rm -f \
    "$data_home/telegram-themes/catppuccin-mocha.tdesktop-theme" \
    "$data_home/telegram-themes/catppuccin-mocha.tdesktop-palette"

printf '%s\n' \
    "Chromium: open chrome://extensions, enable Developer mode, then load unpacked:" \
    "  $chrome_target" \
    "Telegram: open the official cloud theme and confirm it:" \
    "  Telegram -- 'tg://addtheme?slug=ctp_mocha'"
